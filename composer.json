{
  "name": "arraypress/wp-accept-language-utils",
  "description": "A lean WordPress utility for parsing and working with HTTP Accept-Language headers",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-accept-language-utils",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\AcceptLanguageUtils\\": "src/"
    },
    "files": [
      "src/Functions.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-accept-language-utils/issues",
    "source": "https://github.com/arraypress/wp-accept-language-utils"
  },
  "keywords": [
    "wordpress",
    "accept-language",
    "language-detection",
    "locale",
    "i18n",
    "internationalization",
    "http-headers",
    "arraypress"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\AcceptLanguageUtils\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
